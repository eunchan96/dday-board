<?xml version="1.0" encoding="utf-8"?>
<!-- 캘린더: 머리줄(가운데 ‹ 10월 ›, 오른쪽 + · 오늘) + 달력 그림 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/cal_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="이전 달"
                    android:padding="8dp"
                    android:src="@drawable/ic_prev" />
                <TextView
                    android:id="@+id/cal_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:gravity="center"
                    android:text="10월"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/cal_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="다음 달"
                    android:padding="8dp"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
            <!-- 왼쪽: 새로 고침 -->
            <ImageView
                android:id="@+id/refresh"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="start|center_vertical"
                android:alpha="0.6"
                android:contentDescription="새로 고침"
                android:padding="8dp"
                android:src="@drawable/ic_refresh" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/cal_add"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="추가"
                    android:padding="7dp"
                    android:src="@drawable/ic_add" />
                <TextView
                    android:id="@+id/cal_today"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/today_box"
                    android:contentDescription="오늘로"
                    android:gravity="center"
                    android:text="26"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/cal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="달력"
                android:scaleType="fitCenter"
                android:visibility="@integer/vis_day" />
            <ImageView
                android:id="@+id/cal_night"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="달력"
                android:scaleType="fitCenter"
                android:visibility="@integer/vis_night" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
